# Пример конфигурации стенда. Скопируйте в .env и поправьте под стенд.
# На стендах TEST / STAGE / PROD отличаются STAND_NAME, APP_PORT и DATABASE_URL.

# Имя стенда — выводится в шапке интерфейса (test / stage / prod / local)
STAND_NAME=local

# --- База данных ---------------------------------------------------------
# Вариант 1 (по умолчанию): SQLite, ничего дополнительно ставить не нужно
DATABASE_URL=sqlite:///instance/skachki.db

# Вариант 2: PostgreSQL.
#   pip install -r requirements-postgres.txt
# DATABASE_URL=postgresql+psycopg://skachki:skachki@127.0.0.1:5432/skachki

# --- Веб-сервер ----------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080

# Время жизни сессии авторизации, часы
SESSION_TTL_HOURS=12

# Автоматически создавать учётную запись администратора при первом запуске
AUTO_SEED=true

# Наполнять пустую базу демонстрационными данными (лошади, жокеи, состязания).
# На стенде PROD обычно выключают: SEED_DEMO_DATA=false
SEED_DEMO_DATA=true

# Показывать подсказку с демо-учётками на странице входа
DEMO_LOGIN_HINT=true
